{
  "name": "brushwork",
  "version": "0.1.1",
  "description": "Turn a photograph into a painting made of brush strokes",
  "type": "module",
  "bin": {
    "brushwork": "dist/brushwork.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "painterly",
    "brush-strokes",
    "wallpaper",
    "image-processing",
    "cli",
    "non-photorealistic-rendering"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile dist/brushwork.js --external sharp",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrimandylis/brushwork.git"
  }
}
